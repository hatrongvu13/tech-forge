<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.htv</groupId>
        <artifactId>starters</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>grpc-starter</artifactId>
    <name>grpc-starter</name>
    <description>gRPC server/client: vòng đời server, kênh client, interceptor ngữ cảnh, log, lỗi, tra quyền và đăng ký danh mục quyền.</description>

    <dependencies>
        <dependency>
            <groupId>com.htv</groupId>
            <artifactId>core-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.htv</groupId>
            <artifactId>shared-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.htv</groupId>
            <artifactId>shared-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.htv</groupId>
            <artifactId>api-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.htv</groupId>
            <artifactId>grpc-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <!-- Health service + reflection -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
        </dependency>
        <!-- Netty đóng gói sẵn (shaded): không xung đột với Netty của Boot/Reactor -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test: kiểm nhận diện exception của Spring Security theo tên lớp (không phụ thuộc lúc chạy) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
