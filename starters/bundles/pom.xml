<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Starter nhóm: chỉ gom dependency của starter đơn, KHÔNG có code.
         Parent là tech-forge-parent chứ KHÔNG phải starters: luật "starter không phụ thuộc starter khác"
         không áp dụng cho nhóm.
         Đổi công nghệ cho mọi service dùng một nhóm = sửa đúng một pom ở đây. -->
    <parent>
        <groupId>com.htv</groupId>
        <artifactId>tech-forge-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../platform/parent/pom.xml</relativePath>
    </parent>

    <artifactId>bundles</artifactId>
    <packaging>pom</packaging>
    <name>bundles</name>
    <description>Starter nhóm theo tổ hợp công nghệ.</description>

    <modules>
        <module>service-starter</module>
        <module>service-starter-jpa-cache-grpc</module>
        <module>service-starter-jpa-cache-grpc-feign</module>
    </modules>

    <dependencies>
        <!-- Mỗi nhóm có test khởi động một service rỗng chỉ với đúng nhóm đó -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
